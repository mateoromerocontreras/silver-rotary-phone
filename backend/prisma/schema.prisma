generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  password_hash String
  name          String
  currency      String         @default("USD")
  avatar_url    String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  refresh_tokens RefreshToken[]
  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  push_tokens    PushToken[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  OTHER
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  user_id     String      @db.Uuid
  name        String
  type        AccountType
  balance     Int         @default(0)
  institution String?
  color       String?
  icon        String?
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  deleted_at  DateTime?

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("accounts")
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id         String       @id @default(uuid()) @db.Uuid
  user_id    String       @db.Uuid
  name       String
  type       CategoryType
  icon       String
  color      String
  is_default Boolean      @default(false)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  user_id     String          @db.Uuid
  account_id  String          @db.Uuid
  category_id String          @db.Uuid
  type        TransactionType
  amount      Int
  description String
  notes       String?
  date        DateTime
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  deleted_at  DateTime?

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  category_id String   @db.Uuid
  amount      Int
  month       Int
  year        Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, month, year])
  @@map("budgets")
}

enum Platform {
  ANDROID
  IOS
}

model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  platform   Platform
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}
